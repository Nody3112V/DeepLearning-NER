{
  "experiment_name": "bilstm_cnn_crf_phoner_word",
  "seed": 42,
  "data": {
    "dataset": "vlsp",
    "granularity": "word",
    "train_path": "data/processed/vlsp/word/train.jsonl",
    "dev_path": "data/processed/vlsp/word/dev.jsonl",
    "test_path": "data/processed/vlsp/word/test.jsonl",
    "min_word_freq": 1,
    "max_seq_len": 256,
    "max_word_len": 25
  },
  "model": {
    "word_emb_dim": 100,
    "freeze_word_emb": false,
    "use_char_encoder": true,
    "char_encoder_type": "cnn",
    "char_emb_dim": 30,
    "char_hidden_dim": 50,
    "char_kernel_size": 3,
    "bilstm_hidden_dim": 256,
    "bilstm_num_layers": 1,
    "dropout": 0.5,
    "use_crf": true
  },
  "train": {
    "batch_size": 32,
    "num_epochs": 30,
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 1e-05,
    "lr_scheduler": "reduce_on_plateau",
    "lr_factor": 0.5,
    "lr_patience": 2,
    "grad_clip": 5.0,
    "early_stopping_patience": 5
  },
  "logging": {
    "use_wandb": true,
    "project_name": "vietnamese-ner-acl",
    "checkpoint_dir": "outputs/checkpoints/bilstm_crf",
    "prediction_out": "outputs/predictions/bilstm_crf_test.jsonl"
  },
  "member": "tv1"
}